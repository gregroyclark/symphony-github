GITHUB_OWNER=your-org-or-user
GITHUB_REPO=your-repo
GITHUB_TOKEN=github_pat_or_fine_grained_token

# Optional GitHub App auth instead of GITHUB_TOKEN:
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/private-key.pem

# Optional workspace clone target:
# SYMPHONY_REPO_URL=git@github.com:your-org-or-user/your-repo.git
